# Managed by Ansible (infra/ansible/roles/libertin_web). Edits are overwritten.
#
# Read by docker-compose.yml. Variable meanings: docs/deployment.md.
#
# NOTHING SECRET IS RENDERED HERE FROM A COMMITTED FILE. When the backend lands
# (D-003) its credentials come from Ansible Vault or an external secret store,
# never from group_vars in the repository.

# Build-time: Next inlines NEXT_PUBLIC_* into the client bundle, so an image is
# environment-specific and each environment gets its own tag.
NEXT_PUBLIC_SITE_URL={{ libertin_web_site_url }}

# Runtime
WEB_IMAGE={{ libertin_web_image }}
WEB_TAG={{ libertin_web_tag }}
WEB_PORT={{ libertin_web_port }}
TZ={{ libertin_timezone }}
