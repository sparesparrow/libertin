{
  "name": "@libertin/api",
  "version": "0.0.1",
  "description": "Libertin typed API client, locked to contracts/openapi.snapshot.yaml, plus its MSW mocks.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sparesparrow/libertin.git",
    "directory": "packages/api"
  },
  "main": "./src/index.ts",
