{
  "name": "@libertin/e2e",
  "version": "0.0.1",
  "private": true,
  "description": "Cypress end-to-end suite for the Libertin web client (E11-T5).",
  "scripts": {
    "cy:open": "cypress open --e2e",
    "cy:install": "cypress install",
    "cy:verify": "cypress verify",
    "cy:info": "cypress info",
    "e2e": "cypress run",
    "e2e:modules": "node scripts/run-deployed.mjs modules",
    "e2e:platform": "node scripts/run-deployed.mjs platform",
    "e2e:explore": "node scripts/run-deployed.mjs explore",
    "e2e:local": "cypress run --spec \"cypress/e2e/local/**/*.cy.ts\"",
    "e2e:local:ci": "start-server-and-test \"pnpm --filter @libertin/web start\" http://localhost:3000/gate \"pnpm e2e:local\"",
    "type-check": "tsc --noEmit",
    "evidence": "cypress run --spec \"cypress/e2e/evidence/**/*.cy.ts\"",
    "evidence:publish": "node scripts/publish-evidence.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "axe-core": "^4.10.2",
    "cypress": "^15.20.1",
    "cypress-axe": "^1.6.0",
    "start-server-and-test": "^2.0.9",
    "typescript": "*"
  }
}
